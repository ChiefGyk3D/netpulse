# NetPulse Configuration
# Copy this file to .env and modify as needed
#
# For Docker: Used by docker-compose.yml
# For Local:  setup.sh generates /etc/netpulse/netpulse.env from these values
#
# Generate each random value below with:
#   openssl rand -hex 32

# ═══════════════════════════════════════════════════════════════
# Required for Docker Compose (compose stops if one is empty)
# ═══════════════════════════════════════════════════════════════
# Random values, one per variable; do not reuse one value for all three.
INFLUXDB_PASSWORD=
INFLUXDB_TOKEN=
GRAFANA_PASSWORD=

# ═══════════════════════════════════════════════════════════════
# Network exposure (Docker only)
# ═══════════════════════════════════════════════════════════════
# Address the published InfluxDB (8086) and Grafana (3000) ports bind to.
# Default 127.0.0.1 serves this machine only. Set to a specific interface
# address, or 0.0.0.0 for all interfaces, only when you also control access
# (firewall, reverse proxy).
# NETPULSE_BIND_ADDR=127.0.0.1

# InfluxDB Version: "1" for 1.x (username/password) or "2" for 2.x (token-based)
# Docker Compose uses InfluxDB 2.x by default
INFLUXDB_VERSION=2

# InfluxDB Connection (local install; Docker uses http://influxdb:8086)
INFLUXDB_URL=http://localhost:8086

# ═══════════════════════════════════════════════════════════════
# InfluxDB 2.x Settings (token-based authentication)
# Used when INFLUXDB_VERSION=2
# INFLUXDB_TOKEN is in the required section above.
# ═══════════════════════════════════════════════════════════════
INFLUXDB_ORG=netpulse
INFLUXDB_BUCKET=netpulse

# Initial setup account (Docker only - for web UI access)
# The password is INFLUXDB_PASSWORD in the required section above.
INFLUXDB_USERNAME=admin

# ═══════════════════════════════════════════════════════════════
# InfluxDB 1.x Settings (username/password authentication)
# Used when INFLUXDB_VERSION=1
# ═══════════════════════════════════════════════════════════════
# INFLUXDB_DATABASE=netpulse

# ═══════════════════════════════════════════════════════════════
# Grafana Settings (Docker only)
# The password is GRAFANA_PASSWORD in the required section above.
# ═══════════════════════════════════════════════════════════════
GRAFANA_USER=admin

# ═══════════════════════════════════════════════════════════════
# Speedtest Settings
# ═══════════════════════════════════════════════════════════════
# Interval in seconds between speedtests (default: 1800 = 30 minutes)
# For systemd timer: edit /etc/systemd/system/netpulse.timer instead
SPEEDTEST_INTERVAL=1800

# State file for ISP change tracking (auto-configured by setup.sh)
# Docker: /data/state.json (in volume)
# Local:  /var/lib/netpulse/state.json
# NETPULSE_STATE_FILE=/var/lib/netpulse/state.json

# ═══════════════════════════════════════════════════════════════
# Continuous Probe (Docker: opt-in with `docker compose --profile probe up -d`)
# Loss, latency and jitter to a few targets, one burst per target per interval.
# ═══════════════════════════════════════════════════════════════
# Comma-separated: icmp:HOST, tcp:HOST[:PORT] (default 443), https:URL.
# Defaults are public well-known targets; point them at your own if you prefer.
# PROBE_TARGETS=icmp:1.1.1.1,tcp:1.1.1.1:443,https:https://www.cloudflare.com/
# Seconds between bursts (default 60, minimum 10)
# PROBE_INTERVAL=60
# Samples per burst (default 5, maximum 20)
# PROBE_COUNT=5
# Seconds to wait for each sample (default 2)
# PROBE_TIMEOUT=2
# Also write per-target DNS, TCP connect, TLS and first-byte timings to the
# `probe_timing` measurement, one point per target per cycle; a failure is
# written as an error point. 1 = on (default), 0 = off.
# PROBE_TIMING=1

# Timezone
TZ=America/New_York
